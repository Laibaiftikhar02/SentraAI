# SentraAI Backend Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit .env files containing real secrets.

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/sentraai_dev

# JWT settings
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# AI provider — complaint-triage engine
# gemini = real Gemini LLM triage (automatically falls back to local rules
#          on missing key / API error / timeout / rate limit / bad output)
# local  = rule-based provider only (zero cost, no API)
AI_PROVIDER=gemini

# Optional tuning for the Gemini triage provider
# AI_MODEL=gemini-3.6-flash
# AI_TIMEOUT_SECONDS=20
# AI_MAX_RETRIES=1

# Gemini API key — the single Gemini credential shared by the reporting
# chatbot AND the complaint-triage provider
# (free tier — get one from https://aistudio.google.com/apikey)
# Backend-only secret: never expose it to the frontend or commit a real value.
GEMINI_API_KEY=

# Seed account passwords (required by seeding.py)
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_super_admin_password
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
SEED_USER_PASSWORD=CHANGE_ME_user_password
