# SentraAI Backend Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit .env files containing real secrets.

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/sentraai_dev

# JWT settings
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# AI provider (Phase 3)
# AI_PROVIDER=mock
# AI_API_KEY=
# AI_MODEL=

# Gemini API key (free tier — get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Seed account passwords (required by seeding.py)
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_super_admin_password
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
SEED_USER_PASSWORD=CHANGE_ME_user_password
